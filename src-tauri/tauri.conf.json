{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Twilight Garden",
  "version": "0.0.1",
  "identifier": "com.twilight.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "twilight-garden"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://twilight-garden.adiroyboy2.workers.dev/storage/v1/object/public/desktop-updates/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzNTJFNUVFM0QyQUM4QTkKUldTcHlDbzk3dVZTUTVtSzVHZEtqRG54ckhSRHhwVXZ5Nm9wNnBtUjhjQTlwRFJqZkFhKzhvS00K"
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Twilight Garden",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Twilight Garden",
  "version": "0.0.1",
  "identifier": "com.twilight.desktop",
  "build": {
    "frontendDist": "https://twilight-mocha.vercel.app/",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": ""
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "twilight-garden"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://twilight-garden.adiroyboy2.workers.dev/storage/v1/object/public/desktop-updates/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzNTJFNUVFM0QyQUM4QTkKUldTcHlDbzk3dVZTUTVtSzVHZEtqRG54ckhSRHhwVXZ5Nm9wNnBtUjhjQTlwRFJqZkFhKzhvS00K"
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Twilight Garden",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' https://twilight-mocha.vercel.app https://*.supabase.co https://*.supabase.in wss://*.supabase.co; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://twilight-mocha.vercel.app; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https: wss:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}